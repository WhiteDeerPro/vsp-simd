// Current integration map. Solid edges are instantiated in the product
// reference path. Dashed amber nodes are independent experiments/models.
digraph vsp_current_integration {
  graph [
    rankdir=LR,
    bgcolor="#ffffff",
    fontname="DejaVu Sans",
    fontsize=18,
    label="Current VSP control and memory integration",
    labelloc=t,
    nodesep=0.42,
    ranksep=0.78,
    pad=0.20,
    splines=polyline
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#4f6f8f",
    fillcolor="#eaf4ff",
    fontname="DejaVu Sans",
    fontsize=10,
    margin="0.12,0.08"
  ];
  edge [
    color="#2f6f9f",
    fontcolor="#34495e",
    fontname="DejaVu Sans",
    fontsize=9,
    arrowsize=0.68
  ];

  subgraph cluster_program {
    label="Instantiated uword program path: one PC";
    color="#6d9dca";
    style=rounded;

    launch [
      label="launch envelope\n[start_pc,end_pc)\ncontext + group mask + tag seed"
    ];
    control_store [
      label="behavioral control store\nverification reference",
      fillcolor="#fff7dc",
      color="#b58b23"
    ];
    pc_source [
      label="one byte-PC source\n1 pc_q / 1 fetch outstanding\nsequential fetch + redirect poison/drain"
    ];
    framer [
      label="multi-record framer\n4 input words / up to 3 record views\ncross-bundle tail + END cutoff"
    ];
    holding [
      label="raw-record holding\nconsumes record slot 0 only\n(record slot is not a thread)"
    ];
    adapter [
      label="uword action adapter\nclass semantic decode + launch envelope\nmonotonic tag"
    ];

    launch -> pc_source [label="start"];
    launch -> adapter [label="envelope"];
    pc_source -> control_store [dir=both, label="ordered req/rsp"];
    pc_source -> framer [label="bundle"];
    framer -> holding [label="record slot 0"];
    holding -> adapter;
  }

  subgraph cluster_controller {
    label="Strict single-active action path (instantiated)";
    color="#75a986";
    style=rounded;

    decoded_stage [
      label="decoded-action holding\nstall-stable class fields / EXEC packet\nresolved MEMORY base snapshot",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    canonical_stage [
      label="canonical-action holding\nfinal EXEC expansion + legality\n1 entry / non-flow-through",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    state_engine [
      label="sequencer-local state engine\n32 x 32-bit state per context\nSMOVI / SADD / SADDI + read queries",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    branch_control [
      label="CONTROL branch\nJ + EQ/NE/LT/GE signed/unsigned\nrange check + redirect/flush + completion",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    strict_controller [
      label="strict class controller\nEXEC / MEMORY / CONTROL\nglobal single-active + ordered completion",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    exec_cluster [
      label="execution cluster product profile\n1 transient issue slot (not PC/thread)\n4 SIMD4 groups = 16 byte row\nparameter bound: 16 groups = 64 byte row",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    end_control [
      label="CONTROL.END\nwait strong EXEC/MEMORY/VRF quiescence",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];

    adapter -> decoded_stage [label="semantic result"];
    decoded_stage -> canonical_stage [label="cluster-bound action"];
    canonical_stage -> strict_controller [label="registered canonical action"];
    decoded_stage -> state_engine [label="state action"];
    decoded_stage -> branch_control [label="branch"];
    state_engine -> decoded_stage [
      color="#8056a6",
      fontcolor="#684686",
      label="base query before capture / completion"
    ];
    state_engine -> branch_control [
      color="#8056a6",
      fontcolor="#684686",
      label="pair read"
    ];
    branch_control -> pc_source [label="redirect"];
    branch_control -> framer [label="younger-state flush"];
    branch_control -> holding [label="younger raw-record flush"];
    strict_controller -> exec_cluster [label="decoded EXEC"];
    exec_cluster -> strict_controller [
      color="#8056a6",
      fontcolor="#684686",
      label="completion / result"
    ];
    strict_controller -> end_control [label="CONTROL"];
    end_control -> strict_controller [
      color="#8056a6",
      fontcolor="#684686",
      label="END completion"
    ];
  }

  subgraph cluster_memory {
    label="Vector MEMORY path: UNIT_STRIDE + INDEX_U8";
    color="#75a986";
    style=rounded;

    decoded_memory [
      label="optional decoded descriptor ingress\nLOAD / STORE + address mode\nbase + offset + rows + mask",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    memory_modes [
      label="UNIT_STRIDE\nspan code 0=all selected groups; 1..31 explicit\n\nINDEX_U8\nvi byte offset per selected group/lane; decoded span 0\nVGATHER=LOAD / VSCATTER=STORE",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    vector_memory [
      label="vector memory engine\nVRF child sequencing + AGU + fault retirement\n1 active parent / 1 dmem beat outstanding",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    vrf_arbiter [
      label="VRF memory-client arbiter\nread/write response ownership",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    dmem_boundary [
      label="dmem effective-address boundary\nordinary aligned LOAD/STORE beats\nready/valid; no transaction ID",
      fillcolor="#f0edff",
      color="#755eaa"
    ];
    dmem_model [
      label="ordered dmem simulation oracle\nbyte array + strobes + faults\nnot in product cached path",
      fillcolor="#fff7dc",
      color="#b58b23"
    ];
    dmem_policy [
      label="D-side policy core\nLSU + address-space/region routers\nshared MMU + i/d TLB/PTW",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    dmem_endpoints [
      label="product D-side endpoints\nwritable D-cache + private local SRAM\nUNCACHED/DEVICE owner-preserving merge",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    physical_fabric [
      label="shared physical fabric\nD-cache + PTW + uncached/device\nI-cache-native master seam exposed",
      fillcolor="#ecf8ef",
      color="#4e8f62"
    ];
    lower_boundary [
      label="generic ordered physical lower port\nsingle outstanding / protocol neutral",
      fillcolor="#f0edff",
      color="#755eaa"
    ];
    future_memory [
      label="external SoC target integration\nbus adapter + RAM/MMIO decode\nDMA is a separate producer/client",
      style="rounded,dashed,filled",
      fillcolor="#f6f6f6",
      color="#999999"
    ];

    decoded_memory -> strict_controller [label="reference input"];
    strict_controller -> memory_modes [label="decoded MEMORY"];
    memory_modes -> vector_memory;
    vector_memory -> strict_controller [
      color="#8056a6",
      fontcolor="#684686",
      label="parent completion"
    ];
    vector_memory -> vrf_arbiter [dir=both, label="VRF child transaction"];
    vrf_arbiter -> exec_cluster [dir=both, label="group VRF endpoint"];
    vector_memory -> dmem_boundary [dir=both, label="one beat at a time"];
    dmem_boundary -> dmem_model [dir=both, style=dashed, color="#b58b23", label="oracle"];
    dmem_boundary -> dmem_policy [dir=both, label="product"];
    dmem_policy -> dmem_endpoints [dir=both, label="cache/local/UC/device"];
    dmem_policy -> physical_fabric [dir=both, label="PTW"];
    dmem_endpoints -> physical_fabric [dir=both, label="cache/UC physical traffic"];
    physical_fabric -> lower_boundary [dir=both];
    lower_boundary -> future_memory [dir=both, style=dashed, color="#999999"];
  }

  management_lane [
    label="registered host management lane\nMMU cfg > TLBI > D-cache maint > drain\nprogram inactive + full D-side quiescent",
    fillcolor="#ecf8ef",
    color="#4e8f62"
  ];
  management_lane -> dmem_policy [dir=both, label="MMU/TLB"];
  management_lane -> dmem_endpoints [dir=both, label="D-cache maint"];
  management_lane -> physical_fabric [dir=both, label="drain"];

  subgraph cluster_experimental {
    label="Independent experimental RTL (not connected to product PC/path)";
    color="#c59a3a";
    style="rounded,dashed";

    action_window [
      label="experimental ordered action window\nmultiple entries/candidate views\nviews are not PCs or threads",
      fillcolor="#fff7dc",
      color="#b58b23"
    ];
    register_route [
      label="experimental register-route engine\nVRF snapshot / permutation / commit",
      fillcolor="#fff7dc",
      color="#b58b23"
    ];
    route_wave [
      label="experimental rendezvous + route-wave pipeline\nparticipant/frontier/fan-out studies\nno EXEC_ROUTE/VROUTE product spelling",
      fillcolor="#fff7dc",
      color="#b58b23"
    ];
    ifetch_model [
      label="experimental ordered I-side model\nnot yet bound to program source",
      fillcolor="#fff7dc",
      color="#b58b23"
    ];

    route_wave -> register_route [
      style=dashed,
      color="#b58b23",
      label="standalone test binding"
    ];
  }

  control_gap [
    label="not implemented in product path:\narchitectural I-fetch/I-cache, SoC lower decode/bus,\nmaintenance policy bridge, scalar L/S, CALL/RET,\nreduction-to-state, branch prediction, multi-PC",
    shape=note,
    style="filled,dashed",
    fillcolor="#fff0f0",
    color="#b45b5b"
  ];
  control_gap -> pc_source [style=dashed, color="#b45b5b", label="future control"];
  control_gap -> management_lane [style=dashed, color="#b45b5b", label="global policy"];
  control_gap -> lower_boundary [style=dashed, color="#b45b5b", label="SoC boundary"];

  legend [
    shape=note,
    label="Legend\nblue: instantiated uword transport\ngreen: instantiated semantic/engine/D-side path\namber dashed: independent experiment/model\ngray/red dashed: external or missing boundary\npurple: completion/result return",
    fillcolor="#ffffff",
    color="#9aa7b3"
  ];
}
