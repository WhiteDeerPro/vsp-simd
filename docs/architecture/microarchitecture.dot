// Current RTL visualization; placement is descriptive rather than architectural authority.
digraph vsp_simd_microarchitecture {
  graph [
    rankdir=LR,
    bgcolor="#ffffff",
    fontname="DejaVu Sans",
    fontsize=18,
    label="Current VSP SIMD execution subsystem (behavioral microarchitecture)",
    labelloc=t,
    nodesep=0.42,
    ranksep=0.75,
    pad=0.2,
    splines=polyline
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#f7f9fc",
    color="#51606f",
    fontname="DejaVu Sans",
    fontsize=11,
    margin="0.12,0.08"
  ];
  edge [
    color="#2f6f9f",
    fontcolor="#34495e",
    fontname="DejaVu Sans",
    fontsize=9,
    arrowsize=0.7
  ];

  subgraph cluster_control {
    label="External control plane (current owner: sequencer/test driver)";
    color="#9aa7b3";
    style="rounded,dashed";

    sequencer [
      label="External sequencer / controller\n(profile-v0 action reference exists; queue-head path not drawn)",
      fillcolor="#fff4d6",
      color="#bd8b13"
    ];
    issue_bundle [
      label="Issued control bundle\n6-bit function + element mode + RF addresses\nmask/writeback + route/reduce + use_imm/imm",
      fillcolor="#fffaf0"
    ];
    uop_legal [
      label="Shared uop legality\nop x mode x writeback x route x reduce",
      fillcolor="#fff4d6",
      color="#bd8b13"
    ];
    state_transfer [
      label="cfg_* state-transfer ports\nadmitted only while O and X are empty\n(future DMA / LSU attachment)",
      fillcolor="#f4f0ff",
      color="#7357a5"
    ];

    sequencer -> issue_bundle [style=dashed, color="#8a6d1d"];
  }

  subgraph cluster_state {
    label="Architectural SIMD state (parameterized; defaults shown)";
    color="#7da1bc";
    style=rounded;

    vrf [
      label="VRF\n16 rows x LANES x 8 bit\n2 read / 1 masked write",
      fillcolor="#eaf5ff"
    ];
    arf [
      label="ARF\n8 rows x LANES x 32 bit\n1 read / 1 masked write",
      fillcolor="#eaf5ff"
    ];
    mrf [
      label="MRF\n4 rows x LANES bit\n2 read / 1 masked write",
      fillcolor="#eaf5ff"
    ];
  }

  subgraph cluster_operand {
    label="O: RF-read pipeline boundary and operand preparation";
    color="#77a882";
    style=rounded;

    operand_stage [
      label="1-entry elastic O stage\ncaptured decoded control + VRF A/B + ARF + MRF\nnewer O->X bypass overrides older X-result bypass",
      fillcolor="#e7f6ea",
      color="#4f8b5d"
    ];
    route_a [
      label="Optional source-A route\ngather / broadcast / permutation\nslide up/down",
      fillcolor="#edf9ef"
    ];
    adjacent [
      label="Adjacent SIMD-group\nboundary elements",
      fillcolor="#f4fbf5"
    ];
    imm_broadcast [
      label="Scalar immediate broadcast\nnormal ops: replace B\nWADD/WSUB: shared align\n(no vector immediate)",
      fillcolor="#edf9ef"
    ];
    b_mux [
      shape=diamond,
      label="B source\nnormal ops: use_imm ? imm : VRF-B\nWADD/WSUB: always VRF-B",
      fillcolor="#edf9ef"
    ];
    exec_mask [
      label="Execution mask\nMRF mask or all lanes",
      fillcolor="#edf9ef"
    ];
  }

  subgraph cluster_execute {
    label="O -> X: combinational primary SIMD execution";
    color="#c18c57";
    style=rounded;

    lanes [
      label="Byte lanes + dynamic element path\n\nBYTE/HALF/WORD partitioned ADD/SUB\nshared 5-stage partitioned shifter\npartitioned MIN/MAX + comparison chain\nbyte logic / 8x8 MUL/MAC\nWIDEN and WADD/WSUB\nARF scale / NCLIP / NSLICE",
      fillcolor="#fff2e5",
      color="#ad6c2f"
    ];
    compact [
      label="MRF-driven stable rearrange\nCOMPRESS / EXPAND\nzero fill + population count",
      fillcolor="#fff2e5",
      color="#ad6c2f"
    ];
    mask_alu [
      label="MRF boolean ALU\nMAND / MOR / MXOR / MNOT\noptional all-ones/zero VRF materialization",
      fillcolor="#fff2e5",
      color="#ad6c2f"
    ];
    narrow_result [label="narrow result mux\nLANES x ELEM_W", fillcolor="#fff8ef"];
    wide_result [label="wide result\nLANES x ACC_W", fillcolor="#fff8ef"];
    predicate [label="predicate result\nLANES bits", fillcolor="#fff8ef"];
  }

  subgraph cluster_result {
    label="X: registered execute-result boundary";
    color="#5c8fa8";
    style=rounded;

    exec_result [
      label="1-entry elastic X stage\nnarrow + wide + predicate + result mask + illegal\ndestinations + reduce/count + context/tag metadata",
      fillcolor="#e7f3f8",
      color="#3f7d99"
    ];
  }

  subgraph cluster_commit {
    label="RED/WB: post-X reduction and ordered retirement";
    color="#a37dad";
    style=rounded;

    reduce [
      label="Mask-aware reduction tree\nsum / min / max + index\n(registered narrow input only)",
      fillcolor="#f8effa"
    ];
    vrf_commit [label="VRF execute/cfg write mux\nmasked commit at posedge", fillcolor="#f8effa"];
    arf_commit [label="ARF execute/cfg write mux\nmasked commit at posedge", fillcolor="#f8effa"];
    mrf_commit [label="MRF execute/cfg write mux\nmasked commit at posedge", fillcolor="#f8effa"];
    scalar_out [
      label="Scalar results to sequencer\nreduction: value + index + valid\ncompact: count + valid",
      fillcolor="#f8effa"
    ];
    side_effect_gate [
      label="Unified !uop_illegal gate\ninvalid transaction commits nothing",
      fillcolor="#fff4d6",
      color="#bd8b13"
    ];
  }

  issue_bundle -> operand_stage [style=dashed, color="#7a7a7a", label="admit + capture"];
  operand_stage -> uop_legal [style=dashed, color="#8a6d1d", label="captured contract"];
  operand_stage -> route_a [style=dashed, color="#7a7a7a", label="route control"];
  operand_stage -> b_mux [style=dashed, color="#7a7a7a", label="use_imm"];
  operand_stage -> lanes [style=dashed, color="#7a7a7a", label="op / mode"];
  operand_stage -> compact [style=dashed, color="#7a7a7a", label="op"];
  operand_stage -> mask_alu [style=dashed, color="#7a7a7a", label="op"];
  operand_stage -> exec_mask [style=dashed, color="#7a7a7a"];

  vrf -> operand_stage [label="async source A/B reads"];
  arf -> operand_stage [label="async acc / wide read"];
  mrf -> operand_stage [label="async mask A/B reads"];
  operand_stage -> route_a [label="captured source A"];
  operand_stage -> b_mux [label="captured source B"];
  operand_stage -> imm_broadcast [label="captured scalar imm"];
  imm_broadcast -> b_mux [label="same value / lane"];
  imm_broadcast -> lanes [label="WADD/WSUB align"];
  adjacent -> operand_stage [label="captured slide boundary"];
  route_a -> lanes [label="A"];
  route_a -> compact [label="A"];
  b_mux -> lanes [label="B"];
  operand_stage -> lanes [label="captured ARF / select bits"];
  operand_stage -> exec_mask [label="captured exec mask"];
  operand_stage -> mask_alu [label="captured MRF A / B"];
  exec_mask -> lanes [label="lane enable"];
  exec_mask -> compact [label="selection mask"];

  lanes -> narrow_result;
  compact -> narrow_result;
  compact -> predicate [label="result mask"];
  mask_alu -> narrow_result [label="all ones / zero"];
  mask_alu -> predicate [label="boolean result"];
  lanes -> wide_result;
  lanes -> predicate;
  narrow_result -> exec_result [label="narrow + write mask"];
  wide_result -> exec_result [label="wide"];
  predicate -> exec_result [label="predicate"];
  compact -> exec_result [label="count + valid"];
  narrow_result -> operand_stage [
    style=dashed, color="#2f6f9f", label="newer O->X VRF bypass", constraint=false
  ];
  wide_result -> operand_stage [
    style=dashed, color="#2f6f9f", label="newer O->X ARF bypass", constraint=false
  ];
  predicate -> operand_stage [
    style=dashed, color="#2f6f9f", label="newer O->X MRF bypass", constraint=false
  ];
  exec_result -> operand_stage [
    style=dashed, color="#2f6f9f", label="older registered masked bypass", constraint=false
  ];
  exec_result -> reduce [label="registered narrow + mask"];
  exec_result -> vrf_commit [label="registered narrow"];
  exec_result -> arf_commit [label="registered wide"];
  exec_result -> mrf_commit [label="registered predicate"];
  exec_result -> scalar_out [label="registered count + valid"];
  reduce -> scalar_out;
  uop_legal -> exec_result [style=dashed, color="#8a6d1d", label="capture illegal"];
  exec_result -> side_effect_gate [style=dashed, color="#8a6d1d", label="registered illegal"];
  side_effect_gate -> vrf_commit [style=dashed, color="#8a6d1d", label="write enable"];
  side_effect_gate -> arf_commit [style=dashed, color="#8a6d1d"];
  side_effect_gate -> mrf_commit [style=dashed, color="#8a6d1d"];
  side_effect_gate -> scalar_out [style=dashed, color="#8a6d1d", label="valid"];
  state_transfer -> vrf_commit [color="#7357a5", label="serialized cfg write"];
  state_transfer -> arf_commit [color="#7357a5"];
  state_transfer -> mrf_commit [color="#7357a5"];

  legend [
    shape=note,
    label="Legend\nblue solid: data path\ngray dashed: captured control\nblue dashed: same-edge RAW forwarding\npurple boxes: cfg state transfer / retirement\nO captures RF reads before primary execute\nX captures primary results before reduction\nRED/WB retires registered results in order",
    fillcolor="#ffffff",
    color="#9aa7b3"
  ];
}
