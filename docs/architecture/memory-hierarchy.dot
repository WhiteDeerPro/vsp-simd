// Logical I-side / D-side hierarchy.  The D-side product path is solid;
// dashed nodes/edges remain models or later I-side/SoC integration roles.
digraph vsp_memory_hierarchy {
  graph [
    rankdir=LR,
    bgcolor="#ffffff",
    fontname="DejaVu Sans",
    fontsize=18,
    label="VSP logical I-side / D-side memory boundaries",
    labelloc=t,
    nodesep=0.42,
    ranksep=0.72,
    pad=0.20,
    splines=polyline
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#4f6f8f",
    fillcolor="#eaf4ff",
    fontname="DejaVu Sans",
    fontsize=10,
    margin="0.12,0.08"
  ];
  edge [
    color="#2f6f9f",
    fontcolor="#34495e",
    fontname="DejaVu Sans",
    fontsize=9,
    arrowsize=0.68
  ];

  program_source [
    label="uword program source\nbyte PC + word count\ncurrently 1 outstanding"
  ];
  ifetch_model [
    label="ordered I-side fetch model\nread-only words + ordered responses\nexecutable protocol reference",
    fillcolor="#fff7dc",
    color="#b58b23"
  ];
  icache [
    label="future I-cache role\ncross-line split/fill/reassembly\ninvalidate / instruction visibility",
    style="rounded,dashed,filled",
    fillcolor="#f6f6f6",
    color="#999999"
  ];

  state_engine [
    label="sequencer state engine\nper-context 32-bit address state\nSMOVI / SADD / SADDI",
    fillcolor="#ecf8ef",
    color="#4e8f62"
  ];
  memory_decode [
    label="MEMORY semantic decoder\nsnapshot sbase + signed offset\nUNIT_STRIDE / INDEX_U8",
    fillcolor="#ecf8ef",
    color="#4e8f62"
  ];
  vector_memory [
    label="vector memory engine\nunit-stride + indexed byte AGU\ncurrently 1 dmem beat outstanding"
  ];
  dmem_model [
    label="ordered D-side memory model\nLOAD / STORE + strobe + ack\nexecutable protocol reference",
    fillcolor="#fff7dc",
    color="#b58b23"
  ];
  dcache [
    label="product D-side endpoints\nwritable D-cache + private local SRAM\nUNCACHED/DEVICE fixed-beat adapter",
    fillcolor="#ecf8ef",
    color="#4e8f62"
  ];

  lower_i [
    label="I miss/fill client",
    style="rounded,dashed,filled",
    fillcolor="#f6f6f6",
    color="#999999"
  ];
  lower_d [
    label="D-cache / PTW / uncached-device clients",
    fillcolor="#ecf8ef",
    color="#4e8f62"
  ];
  arbiter [
    label="product physical fabric\nclient ownership held through response\nI-cache-native master seam exposed",
    fillcolor="#ecf8ef",
    color="#4e8f62"
  ];
  address_service [
    label="product D-side address service\nLSU + address-space/region policy\nshared MMU + i/d TLB/PTW",
    fillcolor="#ecf8ef",
    color="#4e8f62"
  ];
  memory [
    label="external ordered lower provider\nSoC bus + RAM/MMIO target decode\nDMA is another explicit client",
    style="rounded,dashed,filled",
    fillcolor="#f6f6f6",
    color="#999999"
  ];

  program_source -> ifetch_model [
    dir=both,
    style=dashed,
    color="#b58b23",
    label="candidate provider adapter; not yet bound"
  ];
  program_source -> address_service [dir=both, style=dashed, color="#999999",
                                     label="I effective address"];
  address_service -> icache [dir=both, style=dashed, color="#999999",
                             label="I translated/protected"];
  icache -> lower_i [dir=both, style=dashed, color="#999999"];

  state_engine -> memory_decode [label="base query"];
  memory_decode -> vector_memory [label="resolved descriptor"];
  vector_memory -> dmem_model [dir=both, style=dashed, color="#b58b23",
                               label="protocol oracle"];
  vector_memory -> address_service [dir=both, label="D effective address"];
  address_service -> dcache [dir=both, label="endpoint policy"];
  address_service -> lower_d [dir=both, label="PTW"];
  dcache -> lower_d [dir=both];

  lower_i -> arbiter [dir=both, style=dashed, color="#999999"];
  lower_d -> arbiter [dir=both];
  arbiter -> memory [dir=both, style=dashed, color="#999999"];

  note [
    shape=note,
    label="Fetch bundle width != I-cache line\nDmem beat width != D-cache line\nI/D logical split != two mandatory physical memories",
    fillcolor="#ffffff",
    color="#9aa7b3"
  ];
}
