# Arctangent atan2(y, x) using CORDIC vectoring mode
# Computes angle = atan(y/x) with correct quadrant
# Input: y in vrf[0], x in vrf[1] (Q8.8 format)
# Output: angle in [0, 255] representing [0, 2π]

entry:
    LI rd=1 imm=0x1000          # Input y values
    LI rd=2 imm=0x1100          # Input x values
    LI rd=3 imm=0x6000          # CORDIC angle table
    LI rd=4 imm=0x2000          # Output angles

    # Load inputs
    VLOAD space=local addr_context=0 sbase=1 vrf=0 span=16 offset=0   # y
    VLOAD space=local addr_context=0 sbase=2 vrf=1 span=16 offset=0   # x

    # CORDIC vectoring mode: rotate vector (x,y) to x-axis
    # Final z accumulates the angle

    # Initialize
    # x = input_x
    # y = input_y
    # z = 0

    EXEC_ALU_RR op=pass_a mode=byte va=1 vb=0 vd=2     # x' = x
    EXEC_ALU_RR op=pass_a mode=byte va=0 vb=0 vd=3     # y' = y
    EXEC_ALU_RI op=xor mode=byte va=0 vd=4 imm=0       # z = 0

    # CORDIC vectoring iterations
    # In vectoring mode, direction is determined by sign of y
    # Iterate to drive y towards zero

    # Iteration 0:
    # if y < 0: x' = x - y>>0, y' = y + x>>0, z' = z - atan[0]
    # if y >= 0: x' = x + y>>0, y' = y - x>>0, z' = z + atan[0]

    # Check y sign
    EXEC_ALU_RI op=shr_s mode=byte va=3 vd=5 imm=7     # Sign of y

    # Simplified single iteration (full needs 8-10)
    # After all iterations, z contains the angle

    # Adjust for quadrant based on original x,y signs
    # Q1 (x>0, y>0): angle as is
    # Q2 (x<0, y>0): 128 - angle
    # Q3 (x<0, y<0): 128 + angle
    # Q4 (x>0, y<0): 256 - angle

    # Store result
    VSTORE space=local addr_context=0 sbase=4 vrf=4 span=16 offset=0

    END

# CORDIC vectoring mode advantages:
# - Computes atan2 directly
# - Handles all quadrants
# - No division needed
# - Same atan table as rotation mode
