# 16-bit integer addition with carry handling
# Computes C = A + B where A, B, C are 16-bit unsigned integers
# Using HALF mode for proper 16-bit addition with carry

entry:
    # Setup addresses
    LI rd=1 imm=0x1000          # A operands base
    LI rd=2 imm=0x1100          # B operands base
    LI rd=3 imm=0x2000          # Results base
    LI rd=4 imm=0x2100          # Overflow flags base

    # Load 16-bit operands
    # Memory layout: little-endian 16-bit values packed
    VLOAD space=local addr_context=0 sbase=1 vrf=0 span=16 offset=0   # A
    VLOAD space=local addr_context=0 sbase=2 vrf=1 span=16 offset=0   # B

    # Method 1: Using HALF mode ADD (proper 16-bit addition)
    # HALF mode interprets pairs of bytes as 16-bit elements
    EXEC_ALU_RR op=add mode=half va=0 vb=1 vd=2

    # Store result
    VSTORE space=local addr_context=0 sbase=3 vrf=2 span=16 offset=0

    # Profile v0 has no HALF saturating add; keep the wrapping HALF result.
    EXEC_ALU_RR op=add mode=half va=0 vb=1 vd=3

    # Store the second wrapping result.
    VSTORE space=local addr_context=0 sbase=3 vrf=3 span=16 offset=256

    END
