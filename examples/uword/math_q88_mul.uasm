# Fixed-point Q8.8 multiplication
# Multiply two Q8.8 numbers: result = (a * b) >> 8
# Keeps the result in Q8.8 format

entry:
    LI rd=1 imm=0x1000          # A operands (Q8.8)
    LI rd=2 imm=0x1100          # B operands (Q8.8)
    LI rd=3 imm=0x2000          # Results (Q8.8)

    # Load Q8.8 values (16-bit each)
    VLOAD space=local addr_context=0 sbase=1 vrf=0 span=16 offset=0
    VLOAD space=local addr_context=0 sbase=2 vrf=1 span=16 offset=0

    # Extract components for 16-bit multiplication
    # A_lo, A_hi
    EXEC_ALU_RI op=and mode=byte va=0 vd=2 imm=0xff
    EXEC_ALU_RI op=shr_u mode=byte va=0 vd=3 imm=8

    # B_lo, B_hi
    EXEC_ALU_RI op=and mode=byte va=1 vd=4 imm=0xff
    EXEC_ALU_RI op=shr_u mode=byte va=1 vd=5 imm=8

    # Multiply components
    EXEC_ALU_RR op=mul_u mode=byte va=2 vb=4 vd=6     # lo*lo
    EXEC_ALU_RR op=mul_u mode=byte va=2 vb=5 vd=7     # lo*hi
    EXEC_ALU_RR op=mul_u mode=byte va=3 vb=4 vd=8     # hi*lo
    EXEC_ALU_RR op=mul_u mode=byte va=3 vb=5 vd=9     # hi*hi

    # For Q8.8 * Q8.8 = Q16.16, we need to shift right by 8
    # to get back to Q8.8 format

    # The result is approximately:
    # result[15:8] = middle_sum[7:0] = (lo*hi + hi*lo + (lo*lo)>>8)[7:0]
    # result[23:16] = hi*hi[7:0] + carry from middle terms

    # Add middle terms (simplified)
    EXEC_ALU_RR op=add mode=byte va=7 vb=8 vd=10      # lo*hi + hi*lo

    # Shift lo*lo right by 8 to align with middle terms
    EXEC_ALU_RI op=shr_u mode=byte va=6 vd=11 imm=8

    # Add to middle sum
    EXEC_ALU_RR op=add mode=byte va=10 vb=11 vd=12    # Middle byte of result

    # Combine with high product for final Q8.8 result
    # This is a simplified version - full implementation needs proper alignment

    # Store result (middle 16 bits of 32-bit product)
    VSTORE space=local addr_context=0 sbase=3 vrf=12 span=16 offset=0

    END

# Note: Proper Q8.8 multiplication requires:
# 1. Full 32-bit product computation
# 2. Right shift by 8 to restore Q8.8 format
# 3. Rounding of the shifted-out bits
# 4. Overflow detection and saturation
