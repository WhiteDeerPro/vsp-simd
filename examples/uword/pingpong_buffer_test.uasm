# Sequential two-bank VRF layout for a future ping-pong experiment.
#
# Current product behavior is global single-active: LOAD, EXEC, and STORE
# below execute strictly in program order.  The separate row sets provide
# simultaneous residency, not current compute/memory overlap.
#
# Launch contract:
#   - four-group profile
#   - group_mask = 0xf
#   - span=16 therefore transfers one 16-byte distributed VRF row
#
# Default-model memory layout:
#   0x0100..0x017f: two 64-byte input blocks
#   0x0200..0x027f: two 64-byte output blocks
#
# VRF allocation:
#   rows  0.. 3: block 0 input
#   rows  4.. 7: block 1 input
#   rows  8..11: block 0 output
#   rows 12..15: block 1 output
#
# Per-byte transform: output = (input + 1) * 2 modulo 256.
# The complete source is 61 stream words, within the default 64-word store.

entry:
LI rd=1 imm=0x0100
LI rd=2 imm=0x0200

# Load block 0 into its four input rows.
VLOAD space=local addr_context=0 sbase=1 vrf=0 span=16 offset=0
VLOAD space=local addr_context=0 sbase=1 vrf=1 span=16 offset=16
VLOAD space=local addr_context=0 sbase=1 vrf=2 span=16 offset=32
VLOAD space=local addr_context=0 sbase=1 vrf=3 span=16 offset=48

# Compute block 0 into a disjoint output row set.
EXEC_ALU_RI op=add mode=byte va=0 vd=8 imm=1
EXEC_ALU_RR op=add mode=byte va=8 vb=8 vd=8
EXEC_ALU_RI op=add mode=byte va=1 vd=9 imm=1
EXEC_ALU_RR op=add mode=byte va=9 vb=9 vd=9
EXEC_ALU_RI op=add mode=byte va=2 vd=10 imm=1
EXEC_ALU_RR op=add mode=byte va=10 vb=10 vd=10
EXEC_ALU_RI op=add mode=byte va=3 vd=11 imm=1
EXEC_ALU_RR op=add mode=byte va=11 vb=11 vd=11

# Load block 1 while block 0 output remains resident.  This is still serial.
VLOAD space=local addr_context=0 sbase=1 vrf=4 span=16 offset=64
VLOAD space=local addr_context=0 sbase=1 vrf=5 span=16 offset=80
VLOAD space=local addr_context=0 sbase=1 vrf=6 span=16 offset=96
VLOAD space=local addr_context=0 sbase=1 vrf=7 span=16 offset=112

# Store block 0.
VSTORE space=local addr_context=0 sbase=2 vrf=8 span=16 offset=0
VSTORE space=local addr_context=0 sbase=2 vrf=9 span=16 offset=16
VSTORE space=local addr_context=0 sbase=2 vrf=10 span=16 offset=32
VSTORE space=local addr_context=0 sbase=2 vrf=11 span=16 offset=48

# Compute block 1 into its disjoint output row set.
EXEC_ALU_RI op=add mode=byte va=4 vd=12 imm=1
EXEC_ALU_RR op=add mode=byte va=12 vb=12 vd=12
EXEC_ALU_RI op=add mode=byte va=5 vd=13 imm=1
EXEC_ALU_RR op=add mode=byte va=13 vb=13 vd=13
EXEC_ALU_RI op=add mode=byte va=6 vd=14 imm=1
EXEC_ALU_RR op=add mode=byte va=14 vb=14 vd=14
EXEC_ALU_RI op=add mode=byte va=7 vd=15 imm=1
EXEC_ALU_RR op=add mode=byte va=15 vb=15 vd=15

# Store block 1.
VSTORE space=local addr_context=0 sbase=2 vrf=12 span=16 offset=64
VSTORE space=local addr_context=0 sbase=2 vrf=13 span=16 offset=80
VSTORE space=local addr_context=0 sbase=2 vrf=14 span=16 offset=96
VSTORE space=local addr_context=0 sbase=2 vrf=15 span=16 offset=112

END
