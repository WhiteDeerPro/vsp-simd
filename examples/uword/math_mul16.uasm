# 16-bit integer multiplication using 8-bit SIMD
# Computes C = A * B where A, B, C are 16-bit unsigned integers
# Uses Karatsuba-like decomposition: (ah*256 + al) * (bh*256 + bl)

entry:
    # Load 16-bit operands (stored as pairs of bytes)
    # Layout: [a0_lo, a0_hi, a1_lo, a1_hi, ...] in memory
    LI rd=1 imm=0x1000          # Base address for A operands
    LI rd=2 imm=0x1100          # Base address for B operands
    LI rd=3 imm=0x2000          # Base address for results (32-bit)

    # Load A and B values (16 bytes each = 8 x 16-bit values)
    VLOAD space=local addr_context=0 sbase=1 vrf=0 span=16 offset=0   # A values
    VLOAD space=local addr_context=0 sbase=2 vrf=1 span=16 offset=0   # B values

    # Split into high and low bytes
    # Extract low bytes (positions 0,2,4,6,8,10,12,14)
    # Extract high bytes (positions 1,3,5,7,9,11,13,15)

    # For 16-bit multiplication: (ah*256 + al) * (bh*256 + bl)
    # = ah*bh*65536 + (ah*bl + al*bh)*256 + al*bl

    # Step 1: Compute al * bl (low × low)
    # Using byte MUL on even positions would give us partial products
    # Since we don't have direct HALF mode multiply, we use byte multiply + shift

    # Create masks to extract even/odd bytes
    EXEC_ALU_RI op=and mode=byte va=0 vd=2 imm=0xff    # A low bytes (at even positions)
    EXEC_ALU_RI op=shr_u mode=byte va=0 vd=3 imm=8     # A high bytes (shift to position)

    EXEC_ALU_RI op=and mode=byte va=1 vd=4 imm=0xff    # B low bytes
    EXEC_ALU_RI op=shr_u mode=byte va=1 vd=5 imm=8     # B high bytes

    # Multiply components (using byte MUL, results go to ARF then narrow back)
    # al * bl
    EXEC_ALU_RR op=mul_u mode=byte va=2 vb=4 vd=6      # al * bl (8x8=16bit in ARF)

    # ah * bl
    EXEC_ALU_RR op=mul_u mode=byte va=3 vb=4 vd=7      # ah * bl

    # al * bh
    EXEC_ALU_RR op=mul_u mode=byte va=2 vb=5 vd=8      # al * bh

    # ah * bh
    EXEC_ALU_RR op=mul_u mode=byte va=3 vb=5 vd=9      # ah * bh

    # Note: MUL_U produces 16-bit results in internal representation
    # Need to extract and combine them properly

    # For a complete 16x16 multiply, we need:
    # result[15:0]  = (al*bl)[7:0]
    # result[23:16] = (al*bl)[15:8] + (ah*bl)[7:0] + (al*bh)[7:0]
    # result[31:24] = (ah*bh)[7:0] + carry from middle terms

    # This is a simplified version showing the structure
    # Full implementation requires carry propagation logic

    # Store low 16 bits of result (placeholder)
    VSTORE space=local addr_context=0 sbase=3 vrf=6 span=16 offset=0

    END
