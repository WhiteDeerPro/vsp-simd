# One-word VRF-indexed vector route instruction. Every line advances the byte
# PC by four; group/context/tag remain resolved action sideband. Repeated
# values in the index row express broadcast.

entry:
EXEC_ROUTE vs=1 vi=2 vd=3
EXEC_ROUTE vs=3 vi=4 vd=5
EXEC_ROUTE vs=5 vi=6 vd=7

# This pseudo-op reuses PASS_A + the existing scalar result channel.  It does
# not write a vector row; the completion carries value and winning lane.
EXEC_REDUCE op=min_u va=4
EXEC_REDUCE op=max_u va=4

CONTROL_END
