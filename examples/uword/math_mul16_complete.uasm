# Complete 16-bit unsigned multiplication
# Algorithm: (A_hi * 256 + A_lo) * (B_hi * 256 + B_lo)
# Result is 32-bit, stored as 4 bytes per result

entry:
    # Initialize
    LI rd=1 imm=0x1000          # A base (16-bit values)
    LI rd=2 imm=0x1100          # B base (16-bit values)
    LI rd=3 imm=0x2000          # Result base (32-bit products)
    LI rd=4 imm=0                # Counter
    LI rd=5 imm=16               # Process 16 bytes (8 x 16-bit pairs)

multiply_loop:
    # Load A and B operands
    VLOAD space=local addr_context=0 sbase=1 vrf=0 span=16 offset=0
    VLOAD space=local addr_context=0 sbase=2 vrf=1 span=16 offset=0

    # Extract low bytes (even positions: 0,2,4,6,...)
    EXEC_ALU_RI op=and mode=byte va=0 vd=2 imm=0xff
    EXEC_ALU_RI op=and mode=byte va=1 vd=3 imm=0xff

    # Extract high bytes (odd positions: 1,3,5,7,...)
    EXEC_ALU_RI op=shr_u mode=byte va=0 vd=4 imm=8
    EXEC_ALU_RI op=shr_u mode=byte va=1 vd=5 imm=8

    # Compute partial products:
    # P0 = A_lo * B_lo (contributes to bits [15:0])
    # P1 = A_lo * B_hi (contributes to bits [23:8])
    # P2 = A_hi * B_lo (contributes to bits [23:8])
    # P3 = A_hi * B_hi (contributes to bits [31:16])

    # P0: low × low
    EXEC_ALU_RR op=mul_u mode=byte va=2 vb=3 vd=6

    # P1: low × high
    EXEC_ALU_RR op=mul_u mode=byte va=2 vb=5 vd=7

    # P2: high × low
    EXEC_ALU_RR op=mul_u mode=byte va=4 vb=3 vd=8

    # P3: high × high
    EXEC_ALU_RR op=mul_u mode=byte va=4 vb=5 vd=9

    # MUL_U produces 16-bit results that need to be combined
    # The result bits [15:0] come from P0
    # The result bits [31:16] come from P3 + high_part(P1+P2)

    # For proper 32-bit result, we'd need to:
    # 1. Extract low and high bytes from each product
    # 2. Add middle terms with carry propagation
    # 3. Combine into final 32-bit result

    # Simplified: Store P0 as low 16 bits
    # (Full implementation requires more steps)
    VSTORE space=local addr_context=0 sbase=3 vrf=6 span=16 offset=0

    # Store P3 as high 16 bits (approximate)
    VSTORE space=local addr_context=0 sbase=3 vrf=9 span=16 offset=256

    # Update pointers
    ADDI rd=1 rs1=1 imm=16
    ADDI rd=2 rs1=2 imm=16
    ADDI rd=3 rs1=3 imm=32      # 32-bit results need 4 bytes each
    ADDI rd=4 rs1=4 imm=16

    BLTU rs1=4 rs2=5 target=multiply_loop

    END
