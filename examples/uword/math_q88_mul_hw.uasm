# Q8.8 fixed-point multiplication using hardware MUL/MAC
# Q8.8 format: 8 bits integer, 8 bits fraction
# (a * b) >> 8 to maintain Q8.8 format after multiply

entry:
    LI rd=1 imm=0x1000          # A operands (Q8.8 values, 16-bit)
    LI rd=2 imm=0x1100          # B operands (Q8.8 values, 16-bit)
    LI rd=3 imm=0x2000          # Results (Q8.8)

    # Load Q8.8 values (16-bit each, stored as [lo, hi] byte pairs)
    VLOAD space=local addr_context=0 sbase=1 vrf=0 span=16 offset=0
    VLOAD space=local addr_context=0 sbase=2 vrf=1 span=16 offset=0

    # Extract byte components
    EXEC_ALU_RI op=and mode=byte va=0 vd=2 imm=0xff    # A_lo
    EXEC_ALU_RI op=shr_u mode=byte va=0 vd=3 imm=8     # A_hi
    EXEC_ALU_RI op=and mode=byte va=1 vd=4 imm=0xff    # B_lo
    EXEC_ALU_RI op=shr_u mode=byte va=1 vd=5 imm=8     # B_hi

    # Four partial products
    # For Q8.8 * Q8.8 = Q16.16, we need middle 16 bits for Q8.8 result
    # Result[15:8] comes from: (A_lo*B_lo)[15:8] + (A_lo*B_hi + A_hi*B_lo)[7:0]
    # Result[7:0] comes from: (A_lo*B_lo)[15:8]

    EXEC_MUL_RR op=mul_u va=2 vb=4 dst_arf=0           # P0 = A_lo*B_lo
    EXEC_MUL_RR op=mul_u va=2 vb=5 dst_arf=1           # P1 = A_lo*B_hi
    EXEC_MAC_RR op=mac_u va=3 vb=4 src_arf=1 dst_arf=1 # P1 += A_hi*B_lo
    EXEC_MUL_RR op=mul_u va=3 vb=5 dst_arf=2           # P3 = A_hi*B_hi

    # Q8.8 result extraction strategy:
    # We want bits [23:8] of the 32-bit product
    # - Bits [7:0] of result = bits [15:8] of P0
    # - Bits [15:8] of result = bits [7:0] of (P1+P2) + carry from P0[15:8]

    # Extract relevant bytes using NSLICE
    EXEC_WIDE_RI op=nslice arf=0 shift=8 vd=6    # P0[15:8] -> result_lo (Q8.8[7:0])
    EXEC_WIDE_RI op=nslice arf=1 shift=0 vd=7    # (P1+P2)[7:0] -> result_hi (Q8.8[15:8])

    # For better precision, could add carry handling:
    # EXEC_WIDE_RI op=nslice arf=0 shift=16 vd=8  # P0[23:16] for carry
    # EXEC_ALU_RR op=add mode=byte va=7 vb=8 vd=7  # Add carry to high byte

    # Combine into 16-bit Q8.8 result
    # In practice, these would be packed into proper byte order
    # For now, store the two extracted bytes
    VSTORE space=local addr_context=0 sbase=3 vrf=6 span=16 offset=0

    END

# Status: BLOCKED - needs signed Q8.8 semantics definition
#
# BLOCKER B: Q8.8 signed multiplication needs:
# 1. Signed high byte × signed high byte (use MUL_S)
# 2. Mixed signed/unsigned cross products
# 3. Proper sign extension and carry handling
# 4. Rounding/truncation strategy (round-to-nearest? truncate?)
# 5. Overflow handling (saturate to ±127.996? wrap?)
#
# Current issues:
# - Uses MUL_U for all partial products (incorrect for signed)
# - No specification of rounding mode
# - No boundary testing (0, ±1 LSB, ±0.5, ±1.0, -128, max, overflow)
#
# Required before FFT integration:
# 1. Document signed Q8.8 partial product formula
# 2. Specify rounding and saturation strategy
# 3. RTL boundary test with known edge cases
# 4. Compare against behavioral golden (not same implementation)
#
# See: issues/open/FFT微码RTL闭环执行缺口-Codex-2026-09-03.md
#
# Q8.8 multiplication algorithm:
# Input: A = a_int + a_frac/256, B = b_int + b_frac/256
# Output: (A * B) in Q8.8 format
#
# Full 32-bit product layout:
# [31:24] [23:16] [15:8] [7:0]
#   P3      P3    P1+P2   P0
#         + carry + P0>>8
#
# Q8.8 result = bits [23:8] = [result_hi:result_lo]
#
# Dynamic range: [-128.0, 127.996] with 1/256 precision
