# Complete 16-bit multiplication using VSP's 8x8 hardware multipliers
# Implements full 32-bit result: (A_hi*256 + A_lo) * (B_hi*256 + B_lo)
# Result = A_lo*B_lo + (A_lo*B_hi + A_hi*B_lo)*256 + A_hi*B_hi*65536

entry:
    LI rd=1 imm=0x1000          # A operands (16-bit values, little-endian)
    LI rd=2 imm=0x1100          # B operands (16-bit values)
    LI rd=3 imm=0x2000          # Result base (32-bit products)

    # Load 16-bit operands as byte pairs
    # Format: each 16-bit value stored as [lo_byte, hi_byte]
    VLOAD space=local addr_context=0 sbase=1 vrf=0 span=16 offset=0  # A
    VLOAD space=local addr_context=0 sbase=2 vrf=1 span=16 offset=0  # B

    # Extract byte components
    # For little-endian: even bytes = low, odd bytes = high
    EXEC_ALU_RI op=and mode=byte va=0 vd=2 imm=0xff    # A_lo (even positions)
    EXEC_ALU_RI op=shr_u mode=byte va=0 vd=3 imm=8     # A_hi (odd positions)
    EXEC_ALU_RI op=and mode=byte va=1 vd=4 imm=0xff    # B_lo
    EXEC_ALU_RI op=shr_u mode=byte va=1 vd=5 imm=8     # B_hi

    # Four 8x8 multiplications producing 16-bit results in ARF
    # P0 = A_lo * B_lo (bits [15:0] of final result)
    EXEC_MUL_RR op=mul_u va=2 vb=4 dst_arf=0

    # P1 = A_lo * B_hi (contributes to bits [23:8])
    EXEC_MUL_RR op=mul_u va=2 vb=5 dst_arf=1

    # P2 = A_hi * B_lo (also contributes to bits [23:8], add to P1)
    EXEC_MAC_RR op=mac_u va=3 vb=4 src_arf=1 dst_arf=1

    # P3 = A_hi * B_hi (bits [31:16] of final result)
    EXEC_MUL_RR op=mul_u va=3 vb=5 dst_arf=2

    # Now we have in ARF:
    # ARF[0] = P0 (16-bit): contributes result[15:0]
    # ARF[1] = P1+P2 (16-bit): contributes result[23:8]
    # ARF[2] = P3 (16-bit): contributes result[31:16]

    # Extract bytes from ARF using NSLICE
    # Result layout: [31:24]=[23:16]=[15:8]=[7:0]
    #                  P3_hi   P3_lo  P1P2   P0_hi  (with carries)

    # Extract low 16 bits from P0 (A_lo * B_lo)
    EXEC_WIDE_RI op=nslice arf=0 shift=0 vd=6    # P0[7:0] -> result[7:0]
    EXEC_WIDE_RI op=nslice arf=0 shift=8 vd=7    # P0[15:8] -> temp

    # Extract middle 16 bits from P1+P2
    EXEC_WIDE_RI op=nslice arf=1 shift=0 vd=8    # (P1+P2)[7:0] -> temp
    EXEC_WIDE_RI op=nslice arf=1 shift=8 vd=9    # (P1+P2)[15:8] -> carry

    # Add P0[15:8] to (P1+P2)[7:0] to get result[15:8]
    EXEC_ALU_RR op=add mode=byte va=7 vb=8 vd=10  # result[15:8]

    # Extract P3
    EXEC_WIDE_RI op=nslice arf=2 shift=0 vd=11   # P3[7:0]
    EXEC_WIDE_RI op=nslice arf=2 shift=8 vd=12   # P3[15:8]

    # Add carry from middle sum to P3[7:0] to get result[23:16]
    EXEC_ALU_RR op=add mode=byte va=9 vb=11 vd=13  # result[23:16]

    # Result[31:24] = P3[15:8] + carry from previous (approximation)
    # For simplicity, using P3[15:8] directly (proper implementation needs carry handling)
    EXEC_ALU_RR op=pass_a mode=byte va=12 vb=0 vd=14  # result[31:24]

    # Store 32-bit result (4 bytes: vd=6,10,13,14)
    # In practice would need to pack these into proper layout
    VSTORE space=local addr_context=0 sbase=3 vrf=6 span=16 offset=0

    END

# Status: BLOCKED - needs byte-lane layout decision
#
# BLOCKER B: This implementation assumes 16-bit word semantics which do not exist.
# VSP is byte-lane SIMD. Issues:
# 1. SHR_U mode=byte imm=8 only uses low 3 bits (shift 0, not 8)
# 2. AND mode=byte imm=0xff is identity on 8-bit lanes
# 3. Signed Q8.8 needs mixed signed/unsigned partial products
# 4. Result bytes not packed into storable layout
#
# Required fixes:
# 1. Choose SoA (separate hi/lo arrays) or AoS (gather/scatter interleave) layout
# 2. Implement proper carry propagation for 16×16
# 3. Use explicit byte extraction via NSLICE instead of shift/mask
# 4. Pack result with VSCATTER or byte-wise stores
#
# See: issues/open/FFT微码RTL闭环执行缺口-Codex-2026-09-03.md
#
# This file remains as algorithmic reference but cannot claim:
# - "FUNCTIONAL" status
# - "Q8.8 exact" precision
# - Measured speedup vs software
