# Indexed memory movement replaces register-to-register cluster routing in the
# product path.  VRF row 2 supplies one unsigned byte offset per lane.  With
# four SIMD4 groups, each command transfers 16 selected bytes in group-major,
# lane-ascending order inside the base+0..255 byte window.

entry:
SMOVI rd=1 imm=0x1000
VGATHER space=local addr_context=0 sbase=1 vd=3 vi=2
VSCATTER space=local addr_context=0 sbase=1 vs=3 vi=2

# This pseudo-op reuses PASS_A + the existing scalar result channel.  It does
# not write a vector row; the completion carries value and winning lane.
EXEC_REDUCE op=min_u va=4
EXEC_REDUCE op=max_u va=4

CONTROL_END

