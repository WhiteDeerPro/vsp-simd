# Minimal PC-to-cluster program. The first two actions establish a zero index
# row and a byte value; the vector route uses that VRF index row, and the exact
# final word C0000000 retires the ordered stream.

entry:
    EXEC_ALU_RR op=xor mode=byte va=1 vb=1 vd=1
    EXEC_ALU_RI op=add mode=byte va=1 vd=2 imm=7
    EXEC_ROUTE vs=2 vi=1 vd=3
program_end:
    CONTROL_END
