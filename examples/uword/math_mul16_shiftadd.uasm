# 16-bit multiplication using shift-and-add algorithm
# Computes C = A * B using repeated addition and shifting
# This is a conceptual implementation showing the algorithm

entry:
    LI rd=1 imm=0x1000          # Multiplicand A
    LI rd=2 imm=0x1100          # Multiplier B
    LI rd=3 imm=0x2000          # Product C (32-bit)

    # Load 16-bit operands
    VLOAD space=local addr_context=0 sbase=1 vrf=0 span=16 offset=0   # A
    VLOAD space=local addr_context=0 sbase=2 vrf=1 span=16 offset=0   # B

    # Initialize accumulator to zero
    EXEC_ALU_RR op=xor mode=half va=0 vb=0 vd=2       # acc = 0

    # Multiplication algorithm: for each bit set in B, add (A << bit_position)
    # Bit 0: if B[0] == 1, acc += A << 0
    EXEC_ALU_RI op=and mode=half va=1 vd=3 imm=1      # Extract bit 0 of B
    EXEC_ALU_RR op=and mode=half va=0 vb=3 vd=4       # A if bit set, else 0
    EXEC_ALU_RR op=add mode=half va=2 vb=4 vd=2       # acc += masked A

    # Bit 1: if B[1] == 1, acc += A << 1
    EXEC_ALU_RI op=shr_u mode=half va=1 vd=3 imm=1    # B >> 1
    EXEC_ALU_RI op=and mode=half va=3 vd=3 imm=1      # Extract bit 1
    EXEC_ALU_RI op=shl mode=half va=0 vd=5 imm=1      # A << 1
    EXEC_ALU_RR op=and mode=half va=5 vb=3 vd=4       # Mask
    EXEC_ALU_RR op=add mode=half va=2 vb=4 vd=2       # acc += masked (A<<1)

    # Bit 2: if B[2] == 1, acc += A << 2
    EXEC_ALU_RI op=shr_u mode=half va=1 vd=3 imm=2
    EXEC_ALU_RI op=and mode=half va=3 vd=3 imm=1
    EXEC_ALU_RI op=shl mode=half va=0 vd=5 imm=2
    EXEC_ALU_RR op=and mode=half va=5 vb=3 vd=4
    EXEC_ALU_RR op=add mode=half va=2 vb=4 vd=2

    # Bit 3: if B[3] == 1, acc += A << 3
    EXEC_ALU_RI op=shr_u mode=half va=1 vd=3 imm=3
    EXEC_ALU_RI op=and mode=half va=3 vd=3 imm=1
    EXEC_ALU_RI op=shl mode=half va=0 vd=5 imm=3
    EXEC_ALU_RR op=and mode=half va=5 vb=3 vd=4
    EXEC_ALU_RR op=add mode=half va=2 vb=4 vd=2

    # Continue for remaining bits (4-15) - pattern repeats
    # For brevity, showing first 4 bits
    # Full implementation needs all 16 bits

    # Store 16-bit result (lower 16 bits of product)
    VSTORE space=local addr_context=0 sbase=3 vrf=2 span=16 offset=0

    END

# Note: This shift-and-add multiplier is:
# - Exact for small values
# - Overflows at 16 bits (wraps for full 16x16)
# - Slow: O(16) operations per multiplication
# - Better than no multiplication at all
# For full 32-bit products, need to track high word separately
